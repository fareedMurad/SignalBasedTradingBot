# ─────────────────────────────────────────────────────────────────────────────
#  Exchange Selection
#  Choose which exchange to use: binance | mexc
# ─────────────────────────────────────────────────────────────────────────────
EXCHANGE=mexc

# ─────────────────────────────────────────────────────────────────────────────
#  MEXC Browser Bot Mode
#
#  When true, the dashboard drives the MEXC UI directly via Chrome CDP
#  instead of the REST API for order placement, close and SL/TP updates.
#
#  Requirements:
#    - Chrome must be running with --remote-debugging-port=9222
#    - MEXC Futures tab open at https://www.mexc.com/futures/BTC_USDT
#    - Leverage already pre-set on the MEXC UI (bot does NOT change it)
#
#  This eliminates the mexc-bot as a separate process — everything runs
#  inside a single Node.js process.
# ─────────────────────────────────────────────────────────────────────────────
MEXC_BROWSER_MODE=true

# ─────────────────────────────────────────────────────────────────────────────
#  MEXC Futures API Credentials
#  Get demo keys at: https://futures.mexc.com  →  Simulated Trading
#  Get live keys at: https://www.mexc.com      →  API Management
# ─────────────────────────────────────────────────────────────────────────────
MEXC_API_KEY=mx0vgl1KIwliGqPiO1
MEXC_API_SECRET=2a0b2522f79e458494de3955b9920d6b

# ─────────────────────────────────────────────────────────────────────────────
#  Binance Futures API Credentials  (used when EXCHANGE=binance)
# ─────────────────────────────────────────────────────────────────────────────
API_KEY=your_binance_api_key_here
API_SECRET=your_binance_api_secret_here

# ─────────────────────────────────────────────────────────────────────────────
#  Trading Mode
#
#  USE_DEMO_ENV=true   → MEXC Demo account  (same URL, different API keys)
#                         OR Binance Testnet (testnet.binancefuture.com)
#  USE_DEMO_ENV=false  → MEXC Live / Binance Live
#
#  TRADE_MODE only applies to Binance:
#    testnet  → testnet.binancefuture.com  (software SL/TP, no cond. orders)
#    live     → fapi.binance.com           (real money, exchange SL/TP orders)
#
#  NOTE: For MEXC, software SL/TP is always used (both demo and live).
# ─────────────────────────────────────────────────────────────────────────────
USE_DEMO_ENV=true
USE_TESTNET=false
TRADE_MODE=live

# ─────────────────────────────────────────────────────────────────────────────
#  AWS S3 Configuration (for trade history storage — optional)
# ─────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=trading-bot-history

# ─────────────────────────────────────────────────────────────────────────────
#  Risk Management
# ─────────────────────────────────────────────────────────────────────────────
LEVERAGE=10
RISK_MODE=isolated
MIN_MARGIN_BALANCE=50

# ─────────────────────────────────────────────────────────────────────────────
#  Dashboard Server
# ─────────────────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000

# Dashboard Password (change this!)
DASHBOARD_PASSWORD=selfpride@@007

# ─────────────────────────────────────────────────────────────────────────────
#  Logging
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info


